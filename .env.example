# ─── PostgreSQL ─────────────────────────────────────────────────────
DB_USER=crm_user
DB_PASSWORD=cambia_esto_en_produccion
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@crm-db:5432/crm_tarifas

# ─── JWT ────────────────────────────────────────────────────────────
# IMPORTANTE: Debe ser el MISMO secret que usa zymo-intranet para el SSO
# Genera con: openssl rand -hex 32
JWT_SECRET=cambia_esto_por_el_mismo_secret_del_intranet
JWT_EXPIRES_IN=8h

# ─── Servidor ───────────────────────────────────────────────────────
PORT=3003
NODE_ENV=production

# ─── Superadmin inicial ─────────────────────────────────────────────
# Solo se crea si no existe ningun usuario en la BD
FIRST_SUPERADMIN_USERNAME=Analista_Desarrollo
FIRST_SUPERADMIN_PASSWORD=Admin1234!
