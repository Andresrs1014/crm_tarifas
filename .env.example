# ─── PostgreSQL (Docker: host = crm-db) ─────────────────────────
DB_USER=crm_user
DB_PASSWORD=cambia_esto_en_produccion
DATABASE_URL=postgresql://crm_user:cambia_esto_en_produccion@crm-db:5432/crm_tarifas

# ─── JWT ────────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_secret_seguro_min_32_chars
JWT_EXPIRES_IN=8h

# ─── Servidor ───────────────────────────────────────────────────────
PORT=3003
NODE_ENV=production

# ─── Superadmin inicial ─────────────────────────────────────────────
FIRST_SUPERADMIN_USERNAME=Analista_Desarrollo
FIRST_SUPERADMIN_PASSWORD=Admin1234!

# ─── LOCAL DOCKER (pruebas) ─────────────────────────────────────────
# Usar plantilla lista:  cp .env.docker.local .env
# Ver docs/orquestacion/DOCKER-LOCAL.md
