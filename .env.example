# Copiar a .env y rellenar con valores reales antes de "docker compose up --build -d"

# Firma las cookies de sesión. Generar uno real con: openssl rand -hex 32
# Si cambia, todas las sesiones activas se invalidan (todos deben volver a iniciar sesión).
SESSION_SECRET=

# Solo se usan la PRIMERA vez que arranca (BD sin usuarios todavía).
# Después de eso, crear más usuarios con: node backend/create-user.js <user> <pass> "<nombre>" <admin|comercial>
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NOMBRE=Administrador
