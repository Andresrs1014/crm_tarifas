# ─── Backend ─────────────────────────────────────────────
# Clave secreta JWT — genera una nueva con: openssl rand -hex 32
SECRET_KEY=cambia_esto_por_una_clave_de_al_menos_32_caracteres

# Base de datos (SQLite, ruta dentro del contenedor)
DATABASE_URL=sqlite:///./data/crm_tarifas.db

# Superadmin inicial — se crea solo si no existe ningún usuario en la BD
FIRST_SUPERADMIN_USERNAME=admin
FIRST_SUPERADMIN_PASSWORD=cambia_esta_password
