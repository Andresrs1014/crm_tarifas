# ═══════════════════════════════════════════════════════════════════
# CRM TARIFAS — ENTORNO LOCAL DOCKER (SOLO PRUEBAS)
# Copiar a .env:  cp .env.docker.local .env
# ═══════════════════════════════════════════════════════════════════

# ─── PostgreSQL (servicio crm-db en docker-compose) ───────────────
DB_USER=crm_user
DB_PASSWORD=crm_local_pass_2026
DATABASE_URL=postgresql://crm_user:crm_local_pass_2026@crm-db:5432/crm_tarifas

# ─── JWT (valor de prueba — NO usar en producción) ────────────────
JWT_SECRET=local_dev_jwt_crm_tarifas_a1b2c3d4e5f6789012345678abcd
JWT_EXPIRES_IN=8h

# ─── Servidor Node backend ────────────────────────────────────────
PORT=3003
NODE_ENV=production

# ─── Superadmin inicial (seed si BD vacía) ───────────────────────
FIRST_SUPERADMIN_USERNAME=admin_local
FIRST_SUPERADMIN_PASSWORD=AdminLocal2026!

# ─── CORS (local: frontend va por nginx mismo origen en :82) ─────
# El backend usa proxy nginx; CORS permisivo OK para pruebas locales.
