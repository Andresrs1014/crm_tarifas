generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String              @id @default(uuid())
  username    String              @unique
  password    String
  role        String              @default("usuario") // "superadmin" | "usuario"
  createdAt   DateTime            @default(now()) @map("created_at")
  comercial   Comercial?
  preliqHistorial PreliqHistorial[]

  @@map("users")
}

model Comercial {
  id        String   @id @default(uuid())
  nombre    String
  cargo     String?
  email     String?
  tel       String?
  activo    Boolean  @default(true)
  userId    String?  @unique @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  records   Record[]

  @@map("comerciales")
}

model Record {
  id                 String      @id @default(uuid())
  tipo               String      // "prospecto" | "cliente"
  empresa            String
  nit                String?
  ciudad             String?
  direccion          String?
  categoria          String?     // "A" | "B" | "C"
  comercialId        String      @map("comercial_id")
  comercial          Comercial   @relation(fields: [comercialId], references: [id])
  tipoCliente        String      @default("directo") @map("tipo_cliente")
  clienteIndirectoId String?     @map("cliente_indirecto_id")
  comision           String?
  fecha              DateTime
  proximoSeguimiento DateTime?   @map("proximo_seguimiento")
  observaciones      String?
  estadoProspecto    String?     @map("estado_prospecto")
  estadoCliente      String?     @map("estado_cliente")
  visita             String?
  visitaCliente      String?     @map("visita_cliente")
  fechaVisita        DateTime?   @map("fecha_visita")
  fechaVisitaCliente DateTime?   @map("fecha_visita_cliente")
  facturadoP         String?     @map("facturado_p")
  facturado          String?
  valorP             Int?        @map("valor_p")
  valor              Int?
  nuevoServicio      String?     @map("nuevo_servicio")
  servicioNuevo      String?     @map("servicio_nuevo")
  ingresosEsperados  Int?        @map("ingresos_esperados")
  servicios          Json        @default("[]")
  facturacionLineas  Json        @default("{}") @map("facturacion_lineas")
  stageHistory       Json        @default("[]") @map("stage_history")
  contactos          Contacto[]
  actividades        Actividad[]
  cotizaciones       Cotizacion[]
  crmMeta            CrmMeta?
  matrizRiesgo       MatrizRiesgo?
  gestionDocumental  GestionDocumental?
  fichaCliente       FichaCliente?
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@map("records")
}

model Contacto {
  id            String   @id @default(uuid())
  recordId      String   @map("record_id")
  record        Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  nombre        String
  cargo         String?
  telefono      String?
  email         String?
  direccion     String?
  orden         Int      @default(0)
  cumpleanos    String?
  recibeRegalos Boolean  @default(false) @map("recibe_regalos")
  fotosEntrega  Json     @default("[]") @map("fotos_entrega")
  fdaEntregado  Boolean  @default(false) @map("fda_entregado")

  @@map("contactos")
}

model Actividad {
  id          String   @id @default(uuid())
  recordId    String   @map("record_id")
  record      Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  tipo        String   // "llamada"|"reunion"|"email"|"visita"|"tarea"|"seguimiento"
  descripcion String
  fecha       DateTime
  hora        String?  // "14:30" — solo para tipo visita
  lugar       String?  // dirección/lugar — solo para tipo visita
  origen      String?  // "gestion-documental" | null — trazabilidad GD
  hecho       Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("actividades")
}

model CrmMeta {
  id             String  @id @default(uuid())
  recordId       String  @unique @map("record_id")
  record         Record  @relation(fields: [recordId], references: [id], onDelete: Cascade)
  estadoPipeline String? @default("prospecto") @map("estado_pipeline")
  ingresosCrm    Int?    @map("ingresos_crm")
  obs            String?
  tiempos        Json    @default("{}") @map("tiempos") // {estado: {entrada: iso, salida: iso}}
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("crm_meta")
}

model BibliotecaLinea {
  id       String            @id @default(uuid())
  nombre   String            @unique
  orden    Int               @default(0)
  columnas Json              @default("[]")
  grupos   BibliotecaGrupo[]
  obs      BibliotecaObs[]

  @@map("biblioteca_lineas")
}

model BibliotecaGrupo {
  id      String           @id @default(uuid())
  lineaId String           @map("linea_id")
  linea   BibliotecaLinea  @relation(fields: [lineaId], references: [id], onDelete: Cascade)
  nombre  String
  orden   Int              @default(0)
  items   BibliotecaItem[]

  @@map("biblioteca_grupos")
}

model BibliotecaItem {
  id         String          @id @default(uuid())
  grupoId    String          @map("grupo_id")
  grupo      BibliotecaGrupo @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  nombre     String
  tarifa     String          // NEVER store as number — can be "$559.900" or "0,36%"
  tipoTarifa String          @default("moneda") @map("tipo_tarifa")
  obs        String?
  extraCols  Json            @default("{}") @map("extra_cols")
  orden      Int             @default(0)

  @@map("biblioteca_items")
}

model BibliotecaObs {
  id      String          @id @default(uuid())
  lineaId String          @map("linea_id")
  linea   BibliotecaLinea @relation(fields: [lineaId], references: [id], onDelete: Cascade)
  nombre  String
  html    String

  @@map("biblioteca_obs")
}

model Cotizacion {
  id            String   @id @default(uuid())
  numero        String   @unique       // "COT-001"
  recordId      String?  @map("record_id")
  record        Record?  @relation(fields: [recordId], references: [id], onDelete: SetNull)
  empresa       String
  nit           String?
  ciudad        String?
  contacto      String?
  email         String?
  comercial     String
  paqueteadora  String?
  tarifaTipo    String   @default("biblioteca") @map("tarifa_tipo")
  estado        String   @default("borrador")
  lineas        Json     @default("[]")
  itemsSnapshot Json     @default("{}") @map("items_snapshot")
  obsHtml       Json     @default("{}") @map("obs_html")
  obsLibre      String?  @map("obs_libre")
  htmlPreview   String?  @map("html_preview")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("cotizaciones")
}

model CotNumeroCounter {
  id    Int @id @default(autoincrement())
  valor Int @default(0)

  @@map("cot_numero_counter")
}

model GestionDocumental {
  id          String   @id @default(uuid())
  recordId    String   @unique @map("record_id")
  record      Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  docs        Json     @default("{}") @map("docs") // { docId: { estado, obs, fecha } }
  cicloActual Int      @default(2025) @map("ciclo_actual")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("gestion_documental")
}

model MatrizRiesgo {
  id          String   @id @default(uuid())
  recordId    String   @unique @map("record_id")
  record      Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  companias   Json     @default("[]")
  mercancia   String?
  tipoPersona String?  @map("tipo_persona")
  tiempo      String?
  capital     String?
  frecuencia  String?
  facturacion String?
  cert        String?
  anFin       String?  @map("an_fin")
  puntaje     Float    @default(0)
  riesgo      String   @default("PENDIENTE")
  control     String?
  frecControl String?  @map("frec_control")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("matriz_riesgos")
}

model Analista {
  id     String  @id @default(uuid())
  nombre String
  email  String?
  tel    String?

  @@map("analistas")
}

model FichaCliente {
  id        String   @id @default(uuid())
  recordId  String   @unique @map("record_id")
  record    Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  estado    String   @default("pendiente")
  pct       Int      @default(0)
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("fichas_cliente")
}

model PreliqHistorial {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  empresa      String
  cotNumero    String   @map("cot_numero")
  servicios    Json     @default("[]")   // string[]
  parametros   Json     @default("{}")   // { producto, cif, tipo, numCont, peso, pallets, unidades }
  lineas       Json     @default("[]")   // ResultLine[]
  total        Float    @default(0)
  createdAt    DateTime @default(now())  @map("created_at")

  @@map("preliq_historial")
}
